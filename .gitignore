.DS_Store
__pycache__/
*.pyc
.venv/

# Offline Spec Kit fallback — upstream's release artifact, not ours to commit.
# See vendor/README.md for how to populate it.
vendor/spec-kit-*.zip

# Scratch install targets used while exercising install.sh / tests
/toy/
/.build-scratch/

# Local Claude Code state — a per-command permission allowlist and the
# session worktrees under .claude/worktrees/. Machine-local, never package
# content: a worktree there is a checkout of this repo, not a source of it.
/.claude/

# Nested checkouts of this repo. A clone or worktree under this directory is a
# checkout, never package content — and two of them are how the EC-20 fence
# pass and the source-audit v0.5 drop were both stranded (BUILD-LOG 0.1.45).
# One working copy: author here, commit here. Throwaway checkouts belong under
# .claude/worktrees/ via `git worktree add`, which is already ignored above.
/repo/
/verify/
